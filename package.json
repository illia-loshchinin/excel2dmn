{
  "name": "excel2dmn",
  "version": "1.0.0",
  "description": "Convert pre-formatted Excel decision tables into Camunda 7 or Camunda 8 DMN 1.3 files (and back).",
  "type": "module",
  "license": "MIT",
  "author": "Illia",
  "keywords": [
    "dmn",
    "camunda",
    "camunda7",
    "camunda8",
    "excel",
    "xlsx",
    "decision-table",
    "dmn-1.3",
    "feel",
    "converter"
  ],
  "homepage": "https://github.com/illia-loshchinin/excel2dmn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/illia-loshchinin/excel2dmn.git"
  },
  "bugs": {
    "url": "https://github.com/illia-loshchinin/excel2dmn/issues"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "excel2dmn": "bin/excel2dmn.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "bin",
    "schema",
    "excel2dmn.config.example.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "convert": "node bin/excel2dmn.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "licenses": "license-checker --production --summary",
    "licenses:check": "license-checker --production --onlyAllow 'MIT;MIT*;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;Unlicense;CC0-1.0;(MIT OR GPL-3.0-or-later);(MIT AND Zlib);(WTFPL OR MIT)' --excludePackages 'buffers@0.1.1'",
    "licenses:notices": "node scripts/third-party-notices.js",
    "prepublishOnly": "npm run lint && npm test && npm run licenses:notices"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^15.0.0",
    "dmn-moddle": "^12.0.1",
    "exceljs": "^4.4.0",
    "feelin": "^8.2.0"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "license-checker": "^25.0.1",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
